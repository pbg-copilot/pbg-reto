{
  "name": "@reto/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../.env src/worker.ts",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~0.135.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@reto/shared": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "0.8.2",
    "file-type": "^22.2.0",
    "kysely": "^0.29.7",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
