# Copiar a .env (no se commitea). Todos los valores son de ejemplo y solo locales.

# Puertos publicados en 127.0.0.1
FRONTEND_PORT=8088
BACKEND_PORT=8008
POSTGRES_PORT=5439
S3_PORT=9000
S3_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# PostgreSQL (réplica del repo base)
POSTGRES_USER=reto
POSTGRES_PASSWORD=reto_local_only
POSTGRES_DB=reto

# API
# Orígenes permitidos, separados por coma (8088 = nginx, 5173 = Vite en desarrollo).
APP_ORIGIN=http://localhost:8088,http://localhost:5173
# Base de los enlaces en notificaciones y correos.
PUBLIC_APP_URL=http://localhost:8088
DEMO_PASSWORD=123456
SESSION_TTL_HOURS=8

# Asistente de IA (spec 004). Sin API key se usa el proveedor simulado "fake".
# AI_PROVIDER=anthropic requiere ANTHROPIC_API_KEY (una key asociada a un workspace).
AI_PROVIDER=
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# true = simula la caída del proveedor para la demo D6.
AI_FAKE_FAILURE=false

# Almacenamiento S3 local (RustFS) para adjuntos
S3_BUCKET=reto-attachments
S3_ACCESS_KEY=reto
S3_SECRET_KEY=reto_local_only

# Correo de notificaciones: va a Mailpit (buzón local, nunca correos reales)
EMAIL_NOTIFICATIONS=true

# Solo para correr API y worker fuera de Docker (pnpm dev). Compose usa sus propios valores.
PORT=8008
HOST=127.0.0.1
DATABASE_URL=postgres://reto:reto_local_only@localhost:5439/reto
DATA_DIR=../data
S3_ENDPOINT=http://localhost:9000
SMTP_HOST=localhost
